# Copy to .env and fill in. .env is git-ignored.
# The key comes from https://gptproto.com/dashboard/api-key -- one key, all models.
GPTPROTO_API_KEY=sk-your-key-here

# Video endpoints. Verified against the live API on 2026-10-26:
#   create  POST /api/v3/kwaivgi/kling-4.0/reference-to-video   (JSON body)
#   query   GET  /api/v3/predictions/{task_id}/result
#   auth    Authorization: <key>   <- no "Bearer " prefix
# The model id is part of the create path, not of the request body.
GPTPROTO_BASE_URL=https://gptproto.com
GPTPROTO_VIDEO_CREATE_PATH=/api/v3/kwaivgi/{model}/reference-to-video
GPTPROTO_VIDEO_QUERY_PATH=/api/v3/predictions/{task_id}/result
GPTPROTO_MODEL=kling-4.0
